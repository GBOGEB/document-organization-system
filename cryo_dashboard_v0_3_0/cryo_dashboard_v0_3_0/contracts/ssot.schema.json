{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gbogeb.github.io/document-organization-system/contracts/ssot.schema.json",
  "title": "Cryogenic Material Dashboard SSOT",
  "description": "Dependency-free JSON Schema contract for ssot.json, the Single Source of Truth of the Cryogenic Material Property Dashboard. Mirrors the triad convention of a schema contract per canonical SSOT artifact (see GBOGEB/CODEX, GBOGEB/cryoplant-project contracts/*.schema.json).",
  "type": "object",
  "required": [
    "ssot_meta",
    "project",
    "architecture",
    "materials",
    "validation"
  ],
  "additionalProperties": true,
  "properties": {
    "ssot_meta": {
      "type": "object",
      "required": ["schema_version", "dashboard_version", "canonical_source", "subtree"],
      "additionalProperties": true,
      "properties": {
        "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "dashboard_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "generated": { "type": "string", "format": "date-time" },
        "canonical_source": { "type": "string", "pattern": "^GBOGEB/" },
        "subtree": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "primary_runtime": { "type": "string", "minLength": 1 }
      }
    },
    "materials": {
      "type": "object",
      "required": ["count", "catalog"],
      "additionalProperties": true,
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "catalog": { "type": "array", "minItems": 1 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
