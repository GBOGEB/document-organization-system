{
  "schema_version": "gbogeb.uri-ssot/1",
  "note": "Expected values are written by hand from RFC 3986 / RFC 8089, not generated by either implementation. Each 'expect' lists the fields that must match exactly; null means JSON null.",
  "resolve": [
    {"id": "DOV-1-null", "input": null, "expect_null": true},
    {"id": "DOV-1-empty", "input": "", "expect_null": true},
    {"id": "DOV-1-whitespace", "input": "   \t ", "expect_null": true},
    {"id": "DOV-2-file-empty-authority", "input": "file:///C:/gg_MATH/manifest.json",
     "expect": {"kind": "absolute_uri", "is_absolute": true, "scheme": "file", "has_authority": true, "authority": "", "path": "/C:/gg_MATH/manifest.json", "canonical": "file:///C:/gg_MATH/manifest.json"}},
    {"id": "DOV-2-urn-absent-authority", "input": "urn:oasis:names:tc:SAML:2.0:ac",
     "expect": {"kind": "absolute_uri", "scheme": "urn", "has_authority": false, "authority": null, "path": "oasis:names:tc:SAML:2.0:ac"}},
    {"id": "DOV-3-colon-first-segment-is-a-scheme", "input": "foo:bar/baz",
     "expect": {"kind": "absolute_uri", "is_absolute": true, "scheme": "foo", "has_authority": false, "authority": null, "path": "bar/baz", "canonical": "foo:bar/baz"}},
    {"id": "relative-dot-prefixed", "input": "./foo:bar/baz",
     "expect": {"kind": "relative_reference", "is_absolute": false, "scheme": null, "path": "./foo:bar/baz", "canonical": "./foo:bar/baz"}},
    {"id": "relative-plain", "input": "docs/a b.md",
     "expect": {"kind": "relative_reference", "is_absolute": false, "scheme": null, "has_authority": false, "path": "docs/a b.md"}},
    {"id": "network-path-reference", "input": "//Example.COM/x",
     "expect": {"kind": "relative_reference", "is_absolute": false, "has_authority": true, "authority": "example.com", "canonical": "//example.com/x"}},
    {"id": "normalize-scheme-host-pct-dots", "input": "HTTPS://User@GitHub.COM:443/a/./b/../c/%7ejson?q=%2f#Frag",
     "expect": {"scheme": "https", "authority": "User@github.com:443", "path": "/a/c/%7Ejson", "query": "q=%2F", "fragment": "Frag", "canonical": "https://User@github.com:443/a/c/%7Ejson?q=%2F#Frag"}},
    {"id": "ipv6-literal-host", "input": "http://[FE80::1]:8080/",
     "expect": {"authority": "[fe80::1]:8080", "path": "/"}},
    {"id": "fragment-oid", "input": "https://raw.githubusercontent.com/GBOGEB/gg_MATH/main/m.json#oid:1.3.6.1.4.1.99999.1.4",
     "expect": {"fragment": "oid:1.3.6.1.4.1.99999.1.4", "fragment_oid": "1.3.6.1.4.1.99999.1.4"}},
    {"id": "fragment-not-an-oid", "input": "https://x.example/p#oid:1.02.3",
     "expect": {"fragment_oid": null}},
    {"id": "no-invented-oid", "input": "https://x.example/p",
     "expect": {"fragment": null, "fragment_oid": null}},
    {"id": "windows-drive-backslash", "input": "C:\\gg_MATH\\manifest.json",
     "expect": {"kind": "windows_drive_path", "is_absolute": true, "scheme": "file", "has_authority": true, "authority": "", "path": "/C:/gg_MATH/manifest.json", "canonical": "file:///C:/gg_MATH/manifest.json"}},
    {"id": "windows-drive-forward", "input": "c:/x/y.txt",
     "expect": {"kind": "windows_drive_path", "scheme": "file", "canonical": "file:///c:/x/y.txt"}},
    {"id": "unc-path", "input": "\\\\FileServer\\share\\rtm.html",
     "expect": {"kind": "unc_path", "scheme": "file", "has_authority": true, "authority": "fileserver", "path": "/share/rtm.html", "canonical": "file://fileserver/share/rtm.html"}},
    {"id": "javascript-flagged-not-demoted", "input": "javascript:alert(1)",
     "expect": {"kind": "absolute_uri", "scheme": "javascript", "executable_scheme": true, "path": "alert(1)"}},
    {"id": "data-flagged", "input": "DATA:text/plain,hi",
     "expect": {"scheme": "data", "executable_scheme": true}},
    {"id": "mailto-not-executable", "input": "mailto:a@b.example",
     "expect": {"scheme": "mailto", "executable_scheme": false, "has_authority": false}},
    {"id": "surrounding-whitespace-trimmed", "input": "  https://a.example/  ",
     "expect": {"original": "  https://a.example/  ", "canonical": "https://a.example/"}}
  ],
  "to_relative_reference": [
    {"id": "DOV-3-write-colon-first-segment", "input": "foo:bar/baz", "expect": "./foo:bar/baz"},
    {"id": "colon-in-later-segment-untouched", "input": "foo/bar:baz", "expect": "foo/bar:baz"},
    {"id": "plain-untouched", "input": "docs/readme.md", "expect": "docs/readme.md"}
  ]
}
